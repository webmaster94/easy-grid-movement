{
  "name": "easy-grid-movement",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Foundry VTT movement-range highlighting for square grids.",
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run validate",
    "lint": "eslint .",
    "package": "npm run build && node scripts/package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-manifest.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.10.4",
    "archiver": "^7.0.1",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
